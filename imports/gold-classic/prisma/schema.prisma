// PUBLIC & B2B CONTENT LAYER
// ============================================================================

/// نشترك النشرة البريدية — NewsletterSubscriber
model NewsletterSubscriber {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique @db.VarChar(255)
  name        String?  @db.VarChar(150)
  language    Language @default(AR)
  status      String   @default("ACTIVE") @db.VarChar(20) // ACTIVE | UNSUBSCRIBED
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@index([status])
  @@map("newsletter_subscribers")
}

/// المقالات والمدونة والأكاديمية — Article (BLOG | NEWS | ACADEMY | WORKSHOP)
model Article {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(200)
  type         String   @default("BLOG") @db.VarChar(20) // BLOG | NEWS | ACADEMY | WORKSHOP
  title        Json
  excerpt      Json?
  content      Json
  imageUrl     String?  @db.VarChar(600)
  author       String?  @db.VarChar(150)
  status       String   @default("PUBLISHED") @db.VarChar(20) // DRAFT | PUBLISHED
  publishedAt  DateTime @default(now()) @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  @@index([status, publishedAt])
  @@map("articles")
}

/// برنامج المشترين برنامج الوكلاء — BuyerProgramRegistration
model BuyerProgramRegistration {
  id          String   @id @default(uuid()) @db.Uuid
  companyName String   @db.VarChar(255)
  contactName String   @db.VarChar(150)
  email       String   @db.VarChar(255)
  phone       String?  @db.VarChar(50)
  country     String?  @db.VarChar(150)
  companyType String?  @db.VarChar(100)
  interests   Json?
  message     String?  @db.Text
  status      String   @default("PENDING") @db.VarChar(20) // PENDING | APPROVED | REJECTED
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@index([status])
  @@map("buyer_program_registrations")
}

/// رسائل التواصل — ContactMessage
model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  email     String   @db.VarChar(255)
  product   String?  @db.VarChar(300)
  message   String?  @db.Text
  language  Language @default(EN)
  status    String   @default("NEW") @db.VarChar(20) // NEW | READ | CLOSED
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([status])
  @@map("contact_messages")
}

// ============================================================================
// إدارة العمال وشؤونهم المالية — Workforce & Payroll
// ============================================================================

/// نوع العامل — WorkerType (يحدده الأدمن: حرفي، بائع، محاسب...)
model WorkerType {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(50)
  nameTranslations Json    @default("{}") // { ar, fr, en }
  baseSalary      Decimal  @db.Decimal(14, 2) // الراتب الأساسي الافتراضي لهذا النوع
  salaryCurrency  Currency @default(DZD)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  workers Worker[]

  @@map("worker_types")
}

/// عامل — Worker (سجل العامل براتبه ونوعه)
model Worker {
  id             String     @id @default(uuid()) @db.Uuid
  firstName      String     @db.VarChar(100)
  lastName       String     @db.VarChar(100)
  phone          String?    @db.VarChar(50)
  email          String?    @db.VarChar(255)
  workerTypeId   String     @db.Uuid
  workerType     WorkerType @relation(fields: [workerTypeId], references: [id])
  salary         Decimal    @db.Decimal(14, 2) // الراتب المخصص من الأدمن
  salaryCurrency Currency   @default(DZD)
  hireDate       DateTime?  @db.Timestamptz
  status         String     @default("ACTIVE") @db.VarChar(20) // ACTIVE | ON_LEAVE | TERMINATED
  notes          String?    @db.Text
  createdAt      DateTime   @default(now()) @db.Timestamptz
  updatedAt      DateTime   @updatedAt @db.Timestamptz

  salaryPayments SalaryPayment[]

  @@index([workerTypeId])
  @@index([status])
  @@map("workers")
}

/// دفعة راتب — SalaryPayment (ربط نظام المالية بالعمال)
model SalaryPayment {
  id          String   @id @default(uuid()) @db.Uuid
  workerId    String   @db.Uuid
  worker      Worker   @relation(fields: [workerId], references: [id])
  amount      Decimal  @db.Decimal(14, 2)
  currency    Currency @default(DZD)
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  status      String   @default("PENDING") @db.VarChar(20) // PENDING | PAID | CANCELLED
  paidBy      String?  @db.Uuid // user_id الذي صرف الراتب
  paidAt      DateTime? @db.Timestamptz
  method      String?  @db.VarChar(50) // CASH | BANK_TRANSFER | CHEQUE
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@index([workerId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("salary_payments")
}

// ============================================================================
// PHASE 2 — ERP ADVANCED (المعمارية §4): Suppliers · Procurement · Sales
// ============================================================================
// ملاحظة: المراجع orgId/createdById مراجع منطقية (فهارس) لتسهيل الامتداد؛
// النزاهة تُضمن عبر طبقة التفويض (authz + عضوية org) وليس عبر FK فقط.

/// المورد — Supplier (معمارية §4)
model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  code           String   @db.VarChar(40) // SUP-YYYY-XXX
  legalName      String   @db.VarChar(200)
  tradeName      String?  @db.VarChar(200)
  category       String?  @db.VarChar(50) // SMELTER | REFINER | MINER | DEALER | TANGIER | FABRICANT
  country        String?  @db.VarChar(3)
  contactInfo    Json?
  documents      Json?   // عقود/وثائق المورد (مراجع فقط)
  vatNumber      String? @db.VarChar(50)
  paymentTerms   String? @db.VarChar(100) // NET30 | CASH_ON_DELIVERY | ...
  rating         Decimal? @db.Decimal(3, 2) // 0..5 — تقييم المورد
  status         String  @default("ACTIVE") @db.VarChar(20) // ACTIVE | PAUSED | BLACKLISTED
  createdById    String  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  purchaseOrders PurchaseOrder[]

  @@unique([orgId, code])
  @@index([orgId])
  @@index([orgId, status])
  @@map("suppliers")
}

/// عميل/حساب CRM — CrmCustomer (معمارية §4 CRM)
model CrmCustomer {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  type        String   @default("PROSPECT") @db.VarChar(20) // LEAD | PROSPECT | CUSTOMER
  name        String   @db.VarChar(200)
  email       String?  @db.VarChar(255)
  phone       String?  @db.VarChar(30)
  country     String?  @db.VarChar(3)
  source      String?  @db.VarChar(50) // WEBSITE | REFERRAL | B2B | EXHIBITION | ...
  about       Json?
  status      String   @default("OPEN") @db.VarChar(20) // OPEN | NURTURING | CLOSED
  assignedTo  String?  @db.Uuid // user_id
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  interactions  CrmInteraction[]
  opportunities CrmOpportunity[]
  salesOrders   SalesOrder[]
  salesInvoices SalesInvoice[]

  @@index([orgId])
  @@index([orgId, type])
  @@map("crm_customers")
}

/// تفاعل مع عميل — CrmInteraction (سجل التواصل)
model CrmInteraction {
  id           String  @id @default(uuid()) @db.Uuid
  customerId   String  @db.Uuid
  type         String  @db.VarChar(20) // CALL | EMAIL | MEETING | NOTE | WHATSAPP
  summary      String  @db.VarChar(500)
  conductedBy  String  @db.Uuid
  happenedAt   DateTime @default(now()) @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz

  customer CrmCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("crm_interactions")
}

/// فرصة مبيعات — CrmOpportunity (خط مبيعات: اقتباس→تفاوض→فوز/خسارة)
model CrmOpportunity {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @db.Uuid
  amount       Decimal  @db.Decimal(14, 2)
  currency     Currency @default(USD)
  stage        String   @default("QUOTATION") @db.VarChar(20) // QUOTATION | NEGOTIATION | WON | LOST
  probability  Int      @default(10)
  expectedCloseAt DateTime @db.Date
  assignedTo   String?  @db.Uuid
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  customer CrmCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([stage])
  @@map("crm_opportunities")
}

/// طلب شراء — PurchaseRequest (PR) — بداية سلسلة المشتريات
model PurchaseRequest {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  number        String   @db.VarChar(40) // PR-YYYY-XXX
  department    String?  @db.VarChar(100)
  items         Json            // [{sku, description, qty, targetDate?}]
  status        String   @default("DRAFT") @db.VarChar(20) // DRAFT|SUBMITTED|APPROVED|REJECTED|ORDERED
  requestedBy   String   @db.Uuid
  approvedBy    String?  @db.Uuid
  approvedAt    DateTime? @db.Timestamptz
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  @@unique([orgId, number])
  @@index([orgId, status])
  @@map("purchase_requests")
}

/// طلب عرض سعر — Rfq (RFQ — دعوة موردين)
model Rfq {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @db.Uuid
  number       String    @db.VarChar(40) // RFQ-YYYY-XXX
  purchaseRequestId String? @db.Uuid
  items        Json             // نفس عناصر PR أو مخففة
  deadline     DateTime @db.Date
  status       String   @default("DRAFT") @db.VarChar(20) // DRAFT|SENT|RECEIVING|SHORTLISTED|CLOSED
  issuedBy     String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz
  offers       RfqOffer[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@map("rfqs")
}

/// عرض مورد — RfqOffer (عرض داخل RFQ)
model RfqOffer {
  id          String   @id @default(uuid()) @db.Uuid
  rfqId       String   @db.Uuid
  rfq         Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId  String   @db.Uuid
  items       Json             // [{sku, qty, unitPrice}]
  totalAmount Decimal  @db.Decimal(14, 2)
  currency    Currency @default(USD)
  leadTimeDays Int?
  validUntil  DateTime? @db.Date
  status      String   @default("RECEIVED") @db.VarChar(20) // RECEIVED|SHORTLISTED|SELECTED|REJECTED
  submittedBy String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@index([rfqId])
  @@index([supplierId])
  @@map("rfq_offers")
}

/// أمر شراء — PurchaseOrder (PO)
model PurchaseOrder {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  number        String   @db.VarChar(40) // PO-YYYY-XXX
  supplierId    String   @db.Uuid
  rfqOfferId    String?  @db.Uuid
  items         Json             // [{sku, qty, unitPrice}]
  totalAmount   Decimal  @db.Decimal(14, 2)
  currency      Currency @default(USD)
  status        String   @default("DRAFT") @db.VarChar(20) // DRAFT|ISSUED|ACCEPTED|RECEIVING|INSPECTION|COMPLETED|CANCELLED
  placedBy      String   @db.Uuid
  acceptedBy    String?  @db.Uuid
  receivedAt    DateTime? @db.Timestamptz
  paymentStatus String   @default("UNPAID") @db.VarChar(20) // UNPAID|PARTIAL|PAID
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  receipts GoodsReceipt[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([supplierId])
  @@map("purchase_orders")
}

/// إشعار استلام بضاعة — GoodsReceipt (Receiving + Inspection)
model GoodsReceipt {
  id            String   @id @default(uuid()) @db.Uuid
  poId          String   @db.Uuid
  receivedBy    String   @db.Uuid
  items         Json             // [{sku, qty, lot?, condition?}]
  inspectionStatus String @default("PENDING") @db.VarChar(20) // PENDING|INSPECTED|ACCEPTED|REJECTED
  inspectorId   String?  @db.Uuid
  inspectedAt   DateTime? @db.Timestamptz
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz

  po PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@index([inspectionStatus])
  @@map("goods_receipts")
}

/// أمر مبيعات — SalesOrder (SO): اقتباس→أمر→تحقق→دفع→تسليم
model SalesOrder {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  number        String   @db.VarChar(40) // SO-YYYY-XXX
  customerId    String   @db.Uuid
  opportunityId String?  @db.Uuid
  items         Json             // [{sku, qty, unitPrice}]
  totalAmount   Decimal  @db.Decimal(14, 2)
  currency      Currency @default(USD)
  status        String   @default("DRAFT") @db.VarChar(20) // DRAFT|ISSUED|VERIFIED|PAID|FULFILLED|SHIPPED|DELIVERED|CANCELLED
  placedBy      String   @db.Uuid
  verifiedBy    String?  @db.Uuid
  fulfilledBy   String?  @db.Uuid
  paymentRef    String?  @db.VarChar(100)
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  customer  CrmCustomer    @relation(fields: [customerId], references: [id])
  invoices  SalesInvoice[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([customerId])
  @@map("sales_orders")
}

/// فاتورة مبيعات — SalesInvoice
model SalesInvoice {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  number        String   @db.VarChar(40) // INV-YYYY-XXX
  salesOrderId  String?  @db.Uuid
  customerId    String   @db.Uuid
  items         Json             // [{sku, qty, unitPrice, amount}]
  subtotal      Decimal  @db.Decimal(14, 2)
  taxAmount     Decimal  @db.Decimal(14, 2) @default(0)
  totalAmount   Decimal  @db.Decimal(14, 2)
  currency      Currency @default(USD)
  status        String   @default("DRAFT") @db.VarChar(20) // DRAFT|SENT|PARTIAL|PAID|OVERDUE|CANCELLED
  issuedAt      DateTime @db.Timestamptz
  dueAt         DateTime? @db.Timestamptz
  paidAt        DateTime? @db.Timestamptz
  paymentRef    String?  @db.VarChar(100)
  issuedBy      String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  customer   CrmCustomer @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])

  @@index([customerId])
  @@index([orgId, status])
  @@map("sales_invoices")
}
