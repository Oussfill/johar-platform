// ============================================================================
// GOLD GLOBAL DIGITAL PRECIOUS METALS PLATFORM — ENTERPRISE PRISMA SCHEMA
// ============================================================================
// المعيار الأساسي: ONE PHYSICAL ASSET | ONE DIGITAL ID | ONE TRACEABLE HISTORY
// | ONE CONTROLLED DATA MODEL | MULTIPLE VERIFIED SERVICES
//
// الطبقات العشر (10-Layer Enterprise Architecture):
//   L01: Physical Asset       — السبائك، العملات، المجوهرات، المعادن الثمينة
//   L02: Assay & Authentication — فحوصات المختبر (XRF, Fire Assay, Ultrasonic...)
//   L03: Digital Gold Identity — المعرف العالمي الفريد (Gold ID)
//   L04: Digital Passport      — الجواز الرقمي الشامل لكل قطعة
//   L05: Gold ERP              — محرك التسجيلات التشغيلي المركزي
//   L06: AI Intelligence       — تحليل النقاوة، كشف الاحتيال، التنبؤ
//   L07: Blockchain Evidence   — طبقة الإثبات غير القابلة للتعديل (أدلة فقط، لا PII)
//   L08: Global Marketplace    — المنصة التجارية (B2C/B2B/B2G)
//   L09: Custody & Logistics   — إدارة الخزائن والشحن بنظام الاعتماد الثنائي
//   L10: Global Data & API     — ربط المصالح والผู้ معتمدين
//
// معايير الامتثال: ISO/IEC 17025 | ISO 27001 | Zero-Trust Architecture
// ============================================================================

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// LAYER 10: GLOBAL DATA & API ECOSYSTEM — ربط المصالح والجهات الخارجية
// ============================================================================

/// جدول الجهات الم笯فة (المختبرات، المصانع، التجار، الجمارك، البنوك)
/// يمثل كل جهة معتمدة في الشبكة العالمية
model ExternalEntity {
  id                String           @id @default(uuid()) @db.Uuid
  entityCode        String           @unique @db.VarChar(50)
  entityType        EntityType
  name              String           @db.VarChar(200)
  nameAr            String?          @db.VarChar(200)
  nameFr            String?          @db.VarChar(200)
  country           String           @db.VarChar(3) // ISO 3166-1 alpha-3
  city              String?          @db.VarChar(100)
  address           Json?            // العنوان الكامل بالهيكل المnesoi
  registrationNumber String          @db.VarChar(100) // السجل التجاري
  taxId             String?          @db.VarChar(50)
  licenseNumber     String?          @db.VarChar(100) // رقم الترخيص
  licenseExpiry     DateTime?        @db.Timestamptz
  contactEmail      String           @db.VarChar(255)
  contactPhone      String?          @db.VarChar(30)
  publicKeyPem      String?          @db.Text // المفتاح العام للتوقيع الرقمي
  isActive          Boolean          @default(true)
  isVerified        Boolean          @default(false)
  verificationDate  DateTime?        @db.Timestamptz
  metadata          Json?            // بيانات إضافية مرنة
  createdAt         DateTime         @default(now()) @db.Timestamptz
  updatedAt         DateTime         @updatedAt @db.Timestamptz

  // العلاقات
  assayLab          AssayLab?
  goldAsset         GoldAsset[]
  chainOfCustodyFrom ChainOfCustody[] @relation("FromEntity")
  chainOfCustodyTo   ChainOfCustody[] @relation("ToEntity")
  apiKeys           ApiKey[]
  marketplaceItem   MarketplaceItem[]
  custodyVault      CustodyVault?

  @@index([entityType, isActive])
  @@index([country])
  @@map("external_entities")
}

enum EntityType {
  ASSAY_LAB
  REFINERY
  MINE
  MINT
  JEWELLERY_MANUFACTURER
  RETAILER
  CUSTODIAN
  BANK
  CUSTOMS
  INSURER
  LOGISTICS_PROVIDER
  GOVERNMENT_AUTHORITY
  CERTIFICATION_BODY
}

/// مفاتيح API الممنوحة للجهات الخارجية
model ApiKey {
  id            String         @id @default(uuid()) @db.Uuid
  entityId      String         @db.Uuid
  entity        ExternalEntity @relation(fields: [entityId], references: [id])
  keyHash       String         @unique @db.VarChar(255) // هاش المفتاح (لا يُخزن المفتاح العادي)
  keyPrefix     String         @db.VarChar(8)           // أول 8 أحرف للتمييز
  name          String         @db.VarChar(100)
  scopes        Json           // قائمة الصلاحيات ["assets:read", "assay:write"]
  rateLimit     Int            @default(1000) // طلبات/دقيقة
  expiresAt     DateTime?      @db.Timestamptz
  lastUsedAt    DateTime?      @db.Timestamptz
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz

  @@index([entityId, isActive])
  @@map("api_keys")
}

// ============================================================================
// USER & RBAC SYSTEM — إدارة المستخدمين والصلاحيات
// ============================================================================

/// الأدوار المحددة مسبقاً في النظام
model Role {
  id          String        @id @default(uuid()) @db.Uuid
  roleCode    String        @unique @db.VarChar(50) // SUPER_ADMIN, AUDITOR, LAB_TECH, CUSTODIAN...
  nameEn      String        @db.VarChar(100)
  nameAr      String        @db.VarChar(100)
  nameFr      String        @db.VarChar(100)
  description String?       @db.VarChar(500)
  permissions Json          // قائمة الصلاحيات المنظمة ["assets:register", "assay:write", "custody:approve"]
  hierarchy   Int           @default(0) // مستوى السلطة (أعلى أعلى)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  users          User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

// ============================================================================
// JOHAR ACCESS MODEL v1 — RBAC + ABAC (docs/JOHAR-PermissionMatrix-v1.md)
// إضافات تراكمية — لا تكسر النموذج الحالي (Role.permissions يبقى للتوافق)
// ============================================================================

/// أنواع حسابات مستخدمي JOHAR (مواصفة القسم 2)
enum AccountType {
  CUSTOMER
  INDIVIDUAL_SELLER
  PROFESSIONAL
  COMPANY
  MANUFACTURER
  ARTISAN
  TRADER
  IMPORTER_EXPORTER
  SUPPLIER
  DISTRIBUTOR_WHOLESALER
  LABORATORY
  LOGISTICS_OPERATOR
  SERVICE_PROVIDER
  TECHNOLOGY_OPERATOR
  MINING_OPERATOR
  INDUSTRIAL_OPERATOR
  INSTITUTIONAL
}

/// أدوار فريق المؤسسة (مواصفة القسم 17-18)
enum OrgRole {
  OWNER
  ADMIN
  SALES
  PROCUREMENT
  INVENTORY
  LOGISTICS
  FINANCE
  COMPLIANCE
  VIEWER
}

/// جدول الصلاحيات المقننة (السجل الرئيسي من المصفوفة القسم 2)
model Permission {
  id     String @id @default(uuid()) @db.Uuid
  code   String @unique @db.VarChar(100) // module:action e.g. product:update
  module String @db.VarChar(50)
  action String @db.VarChar(50)
  minTier Int   @default(1) // أدنى مستوى تحقق مطلوب (0..3)
  risk   String @default("LOW") @db.VarChar(20) // LOW/MEDIUM/HIGH/CRITICAL/BLOCKED
  isSensitive Boolean @default(false) // يتطلب MFA + Re-auth + Audit
  isActive Boolean @default(true)

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

/// ربط الأدوار بالصلاحيات المقننة (المصفوفة القسم 19)
model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// المؤسسة / حساب الأعمال (مواصفة القسم 8-9)
model Organization {
  id               String    @id @default(uuid()) @db.Uuid
  legalName        String?   @db.VarChar(200)
  tradeName        String    @db.VarChar(200)
  legalForm        String?   @db.VarChar(50)
  registrationCountry String? @db.VarChar(3) // ISO 3166-1 alpha-3
  registrationNumber String? @db.VarChar(100)
  licenseNumber    String?   @db.VarChar(100)
  address          Json?
  contactInfo      Json?
  verificationStatus String @default("UNVERIFIED") @db.VarChar(20) // UNVERIFIED/PENDING/VERIFIED
  kybStatus        String    @default("NOT_STARTED") @db.VarChar(20) // NOT_STARTED/PENDING/VERIFIED/REJECTED
  accountType      AccountType @default(COMPANY)
  ownerId          String    @db.Uuid
  isActive         Boolean   @default(true)
  trustLevel       Int       @default(0) // المستويات المعيارية §12: 0–3 أساسي، 4 بيانات مادية، 5 نتيجة مختبر، 6 شهادة
  trustLevelUpdatedAt DateTime? @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt @db.Timestamptz

  members OrgMember[]
  activeUsers User[] @relation("ActiveOrg")
  trustVerifications TrustVerification[]

  @@index([ownerId])
  @@index([tradeName])
  @@index([trustLevel])
  @@map("organizations")
}

/// عضوية المستخدم في المؤسسة مع مجموعة أدوار (مواصفة القسم 15-17)
model OrgMember {
  id        String  @id @default(uuid()) @db.Uuid
  orgId     String  @db.Uuid
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgRole   OrgRole @default(VIEWER)
  isActive  Boolean @default(true) // يعادل ACTIVE_ORG — عضوية نشطة واحدة لكل مستخدم
  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([orgId, userId])
  @@index([userId, isActive])
  @@map("org_members")
}

// ============================================================================
// نظام الثقة التصاعدية — Trust Levels (§12) — المستويات 4–6
// ============================================================================
// كل عامل (factor) يقابل مستوى معياري:
//   PHYSICAL_DATA → المستوى 4 (البيانات المادية المثبتة)
//   LAB_RESULT    → المستوى 5 (نتيجة مختبر مُعتدة)
//   CERTIFICATION → المستوى 6 (شهادة اعتماد)
// التقصّي/الاعتماد عمل منصة (trust:evaluate) يُدوَّن بسجل تدقيق CRITICAL.

model TrustVerification {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  factor         String   @db.VarChar(24) // PHYSICAL_DATA | LAB_RESULT | CERTIFICATION
  status         String   @default("PENDING") @db.VarChar(16) // PENDING | APPROVED | REJECTED
  evidence       Json     @default("{}") // {assayRecordIds[], certifiedBy, certReference}
  reviewedById   String?  @db.Uuid
  reviewedAt     DateTime? @db.Timestamptz
  rejectionReason String? @db.VarChar(500)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  @@unique([orgId, factor])
  @@index([factor, status])
  @@map("trust_verifications")
}

/// عامل من عوامل الثقة المعيارية (المستويات 4–6)
enum TrustFactor {
  PHYSICAL_DATA // المستوى 4
  LAB_RESULT    // المستوى 5
  CERTIFICATION // المستوى 6
}

/// جدول المستخدمين مع دعم متعدد اللغات و MFA
model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @db.VarChar(255)
  firstName         String    @db.VarChar(100)
  lastName          String    @db.VarChar(100)
  phone             String?   @db.VarChar(30)
  roleId            String    @db.Uuid
  role              Role      @relation(fields: [roleId], references: [id])
  
  // Tier 1: التدويل — اللغة المفضلة والعملة
  preferredLanguage Language  @default(EN) // AR, FR, EN
  preferredCurrency Currency  @default(USD) // DZD, EUR, USD
  
  // Tier 2: الأمان المتقدم (ISO 27001 / Zero-Trust)
  mfaEnabled        Boolean   @default(false)
  mfaSecret         String?   @db.VarChar(255) // TOTP secret
  mfaVerifiedAt     DateTime? @db.Timestamptz
  lastLoginAt       DateTime? @db.Timestamptz
  lastLoginIp       String?   @db.VarChar(45) // IPv6 compatible
  failedLoginCount  Int       @default(0)
  lockoutUntil      DateTime? @db.Timestamptz
  passwordChangedAt DateTime? @db.Timestamptz
  isActive          Boolean   @default(true)
  isEmailVerified   Boolean   @default(false)
  kycStatus         String    @default("NOT_STARTED") @db.VarChar(20) // NOT_STARTED, PENDING, VERIFIED, REJECTED
  avatarUrl         String?   @db.VarChar(500)

  // JOHAR Access Model v1 (مواصفة الصلاحيات)
  accountType       AccountType @default(CUSTOMER) // نوع الحساب
  verificationLevel Int         @default(1) // 0..3 — مستوى التحقق التدريجي
  activeOrgId       String?     @db.Uuid // المؤسسة النشطة الحالية لقواعد ABAC
  activeOrg         Organization? @relation("ActiveOrg", fields: [activeOrgId], references: [id], onDelete: SetNull)
  orgMembers        OrgMember[]
  
  // العلاقات
  auditLogs         AuditLog[]
  emailOtps         EmailOtp[]
  custodyTransferRequestsInitiated CustodyTransferRequest[]
  userVerifications UserVerification[]
  ownershipProcessesAsCustomer OwnershipTransferProcess[] @relation("OwnershipCustomer")
  ownershipKeys     OwnershipKey[] @relation("OwnershipKeyOwner")
  notaryAccount     NotaryAccount?
  escrowAsBuyer     EscrowLedger[] @relation("EscrowBuyer")
  escrowAsSeller    EscrowLedger[] @relation("EscrowSeller")
  
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz

  @@index([roleId])
  @@index([email, isActive])
  @@map("users")
}

// ============================================================================
// OTP PASSWORDS — رموز الدخول المؤقتة عبر البريد الإلكتروني
// ============================================================================

/// رمز دخول لمرة واحدة (OTP) يُرسل عبر البريد الإلكتروني
/// يُخزَّن كـ SHA-256 hash (لا يُخزَّن النص الصريح) مع صلاحية مؤقتة
model EmailOtp {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  codeHash   String    @db.VarChar(64) // SHA-256 للكود — عدم تخزين النص الصريح
  purpose    String    @default("LOGIN") @db.VarChar(20) // LOGIN, REGISTER, PASSWORD_RESET
  attempts   Int       @default(0) // محاولات التحقق الفاشلة
  expiresAt  DateTime  @db.Timestamptz
  consumedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_otps")
}

enum Language {
  AR
  FR
  EN
}

enum Currency {
  DZD
  EUR
  USD
}

// ============================================================================
// LAYER 01: PHYSICAL ASSET — الأصول المادية (سبائك، عملات، مجوهرات)
// ============================================================================

/// السبائك والkuun العملات المعدنية والمجوهرات — الكيان الأساسي في النظام
/// كل قطعة مادية لها سجل رقمي فريد طوال عمرها
model GoldAsset {
  id                String              @id @default(uuid()) @db.Uuid
  
  // المعرف العالمي الفريد (LAYER 03: Digital Gold Identity)
  goldId            String              @unique @db.VarChar(50) // GOLD-XXXX-XXXX-XXXX
  serialNumber      String              @db.VarChar(100) // رقم التسلسلي من المصنع
  manufacturerSerial String?            @db.VarChar(100) // رقم التسلسلي الأصلي
  
  // تصنيف الأصل (LAYER 01)
  productType       ProductType
  metalType         MetalType
  karat             Int?                // 24, 22, 21, 18, 14, 10 (للذهب فقط)
  
  // المواصفات الفيزيائية
  weightGross       Decimal             @db.Decimal(12, 4) // الوزن الإجمالي بالجرام
  weightNet         Decimal             @db.Decimal(12, 4) // الوزن الصافي
  dimensions        Json?               // {length_mm, width_mm, thickness_mm, diameter_mm}
  color             String?             @db.VarChar(30) // أصفي، أحمر، أبيض...

  // صورة المنتج (data URI مخفّضة الضغط عند الرفع)
  productImage      String?             @db.Text
  
  // نتائج الفحص الأولية (LAYER 02: Assay Summary)
  measuredPurity    Decimal?            @db.Decimal(5, 2) // النسبة المئوية للنقاوة
  purityKarat       Int?                // القدر (karat)
  
  // قفل NFC المتقدم (الأمان الفيزيائي)
  nfcUid            String?             @db.VarChar(50) // معرّف شريحة NFC الفريد
  nfcUidHash        String?             @db.VarChar(255) // هاش SHA-256 للـ UID
 ndefLockStatus     NdefLockStatus      @default(UNLOCKED)
  nfcLockedAt       DateTime?           @db.Timestamptz
  nfcLockedBy       String?             @db.Uuid // user_id who locked
  
  // القيمة والتكاليف (محرك التسعير LAYER 08)
  manufacturingCost Decimal?            @db.Decimal(12, 2) // تكلفة التصنيع
  refiningCost      Decimal?            @db.Decimal(12, 2) // تكلفة التنقية
  assayCost         Decimal?            @db.Decimal(12, 2) // تكلفة الفحص
  packagingCost     Decimal?            @db.Decimal(12, 2) // تكلفة التغليف
  
  // الحالة والتتبع
  status            AssetStatus         @default(RAW_MATERIAL)
  originSource      OriginSource        @default(REFINERY)
  
  // العلاقات
  assayRecords      AssayRecord[]
  digitalPassport   DigitalPassport?
  digitalIdentity   DigitalIdentity?
  chainOfCustody    ChainOfCustody[]
  erpInventory      GoldErpInventory?
  aiFraudLogs       AiFraudLog[]
  aiAnalysisResults AiAnalysisResult[]
  blockchainEvidence BlockchainEvidence[]
  marketplaceItems  MarketplaceItem[]
  
  // المنشأة المصدرة
  originEntityId    String?             @db.Uuid
  originEntity      ExternalEntity?     @relation(fields: [originEntityId], references: [id])
  
  // الحقول المترجمة (JSONB i18n)
  nameTranslations  Json                @default("{}") // {ar: "...", fr: "...", en: "..."}
  descriptionTranslations Json?         @default("{}")
  
  createdAt         DateTime            @default(now()) @db.Timestamptz
  updatedAt         DateTime            @updatedAt @db.Timestamptz
  producedAt        DateTime?           @db.Timestamptz // تاريخ الإنتاج الفعلي

  // علاقات الحيازة
  custodyTransferRequests CustodyTransferRequest[]
  ownershipProcesses OwnershipTransferProcess[]

  @@unique([serialNumber, metalType])
  @@index([goldId])
  @@index([metalType, karat])
  @@index([status])
  @@index([originEntityId])
  @@map("gold_assets")
}

enum ProductType {
  BAR
  COIN
  JEWELLERY
  BULLION
  GEMSTONE
  SCRAP
  CUSTOM
}

enum MetalType {
  GOLD
  SILVER
  PLATINUM
  PALLADIUM
  GEMSTONE
}

enum NdefLockStatus {
  UNLOCKED
  LOCKED
  TAMPERED
  DEACTIVATED
}

enum AssetStatus {
  RAW_MATERIAL
  IN_REFINING
  READY_FOR_ASSAY
  IN_ASSAY
  ASSAYED
  CERTIFIED
  INVENTORY
  LISTED
  IN_CUSTODY
  IN_TRANSIT
  DELIVERED
  SOLD
  IN_SECONDARY_MARKET
  RECYCLED
  DECOMMISSIONED
}

enum OriginSource {
  MINE
  REFINERY
  MINT
  JEWELLERY_WORKSHOP
  RECYCLING_CENTER
  CUSTOMS_SEIZURE
  SECONDARY_MARKET
}

// ============================================================================
// LAYER 02: ASSAY & AUTHENTICATION — سجلات الفحص المختبري
// ============================================================================

/// المختبرات المعتمدة (ISO/IEC 17025)
model AssayLab {
  id              String           @id @default(uuid()) @db.Uuid
  entityId        String           @unique @db.Uuid
  entity          ExternalEntity   @relation(fields: [entityId], references: [id])
  
  // اعتمادات المختبر (ISO 17025)
  iso17025CertNumber String        @db.VarChar(100)
  iso17025Expiry    DateTime       @db.Timestamptz
  accreditationScope Json          // قائمة الأساليب المعتمدة ["XRF", "FIRE_ASSAY", "ULTRASONIC"]
  
  // إمكانيات المختبر
  availableMethods  AssayMethod[]
  maxDailyCapacity  Int            @default(100) // عدد العينات الأقصى يومياً
  
  // العلاقات
  assayRecords    AssayRecord[]
  
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz

  @@map("assay_labs")
}

/// سجلات الفحص المختبري لكل قطعة
/// تغطي جميع أساليب الفحص: XRF, Fire Assay, Ultrasonic, Eddy-Current, Optical
model AssayRecord {
  id                String          @id @default(uuid()) @db.Uuid
  assetId           String          @db.Uuid
  asset             GoldAsset       @relation(fields: [assetId], references: [id])
  labId             String          @db.Uuid
  lab               AssayLab        @relation(fields: [labId], references: [id])
  
  // رقم التقرير الفريد من المختبر
  reportNumber      String          @unique @db.VarChar(100)
  
  // نتائج أساليب الفحص المتعددة (LAYER 02)
  density           Decimal?        @db.Decimal(8, 4) // g/cm³
  
  // XRF Analysis (Fluorescence X-Ray)
  xrfPurity         Decimal?        @db.Decimal(5, 2) // النسبة المئوية
  xrfElementBreakdown Json?         // {Au: 99.5, Ag: 0.3, Cu: 0.2}
  xrfScanDate       DateTime?       @db.Timestamptz
  
  // Fire Assay (الأكثر دقة للذهب)
  fireAssayPurity   Decimal?        @db.Decimal(5, 4) // ppt أو نسبة
  fireAssayResult   String?         @db.VarChar(50) // PASS / FAIL
  fireAssayDate     DateTime?       @db.Timestamptz
  
  // Ultrasonic Testing (كشف التجاويف والشوائب)
  ultrasonicTest    String?         @db.VarChar(20) // PASS / FAIL / INCONCLUSIVE
  ultrasonicFindings Json?          // تفاصيل الاكتشافات
  
  // Eddy Current Testing (فحص التوصيل الكهرومغناطيسي)
  eddyCurrentTest   String?         @db.VarChar(20) // PASS / FAIL
  conductivityReading Decimal?      @db.Decimal(8, 4) // % IACS
  
  // Optical Inspection (الفحص البصري)
  opticalInspection String?         @db.VarChar(20) // PASS / FAIL
  opticalFindings   Json?           // صور + ملاحظات الفاحص
  visualScore       Int?            @db.SmallInt // 1-10
  
  // النتيجة الإجمالية
  overallResult     AssayResult     @default(PENDING)
  measuredPurity    Decimal         @db.Decimal(5, 2) // النقاوة النهائية
  certifiedKarat    Int             // القدر المعتمد
  
  // التوقيع الرقمي (أمان مختبري)
  technicianId      String          @db.Uuid
  technicianSignature String        @db.VarChar(500) // التوقيع الرقمي
  labDirectorSignature String?      @db.VarChar(500)
  certHash          String          @db.VarChar(255) // SHA-256 للتقرير
  
  // الشهادة
  certificateUrl    String?         @db.VarChar(500)
  certificateExpiry DateTime?       @db.Timestamptz
  
  createdAt         DateTime        @default(now()) @db.Timestamptz
  updatedAt         DateTime        @updatedAt @db.Timestamptz

  @@index([assetId, overallResult])
  @@index([labId])
  @@index([reportNumber])
  @@map("assay_records")
}

enum AssayMethod {
  XRF
  FIRE_ASSAY
  ULTRASONIC
  EDDY_CURRENT
  OPTICAL
  DENSITY
  ICP_MS
  GRAVIMETRIC
}

enum AssayResult {
