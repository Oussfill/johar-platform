// ============================================================================
// LAYER 07: BLOCKCHAIN EVIDENCE — طبقة الإثبات غير القابلة للتعديل
// ============================================================================

/// إثباتات السلسلة التعшивية — أدلة فقط لا بيانات حساسة (لا PII/KYC)
/// معيار: Tamper-Evident Evidence Layer
model BlockchainEvidence {
  id                String          @id @default(uuid()) @db.Uuid
  assetId           String          @db.Uuid
  asset             GoldAsset       @relation(fields: [assetId], references: [id])
  
  eventType         EvidenceEventType
  evidenceData      Json            // البيانات المشفرة (بدون PII)
  // مثال: {asset_gold_id: "GOLD-...", weight: 100.0, purity: 99.99, action: "TRANSFER"}
  
  // سلسلة الهاشات
  previousHash      String          @db.VarChar(255) // هاش الإثبات السابق
  currentHash       String          @db.VarChar(255) // هاش هذا الإثبات
  merkleRoot        String?         @db.VarChar(255) // جذر ميركل للمجموعة
  
  // معلومات الشبكة
  blockNumber       BigInt?         // رقم الكتلة على الشبكة
  transactionHash   String?         @db.VarChar(255) // هاش المعاملة
  networkId         String?         @db.VarChar(50) // ethereum, polygon...
  contractAddress   String?         @db.VarChar(50) // عنوان العقد الذكي
  
  // مصدر الإثبات
  sourceSystem      String          @db.VarChar(50) // ERP, ASSAY, CUSTODY, MARKETPLACE
  sourceAction      String          @db.VarChar(50) // REGISTER, TRANSFER, VERIFY, UPDATE
  
  // التحقق
  isVerified        Boolean         @default(false)
  verifiedAt        DateTime?       @db.Timestamptz
  verificationCount Int             @default(0)
  
  createdAt         DateTime        @default(now()) @db.Timestamptz

  @@index([assetId, eventType])
  @@index([currentHash])
  @@index([blockNumber])
  @@map("blockchain_evidence")
}

enum EvidenceEventType {
  ASSET_REGISTRATION
  ASSAY_COMPLETION
  CERTIFICATION_ISSUED
  OWNERSHIP_TRANSFER
  CUSTODY_CHANGE
  TRANSPORT_STARTED
  TRANSPORT_COMPLETED
  CUSTOMS_CLEARED
  MARKETPLACE_LISTING
  SALE_COMPLETED
  RECYCLING_INITIATED
  AI_DECISION_HITL
}

