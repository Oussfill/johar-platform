// ============================================================================
// نظام مسار التمليك — Ownership Transfer Process
// ============================================================================
// مبدأ فصل الصلاحيات: 4 أطراف، كل طرف له صلاحية واحدة فقط
// لا يمكن لأي طرف منفرد إتمام العملية وحده

/// مراحل مسار التمليك الأربعة
enum OwnershipStep {
  PURCHASE_REQUEST       // الخطوة 1: طلب الشراء من الزبون
  NOTARY_CERTIFICATION   // الخطوة 2: توثيق كاتب العدل
  KEY_ISSUANCE           // الخطوة 3: إصدار المفتاح للزبون
  REGISTRAR_ACTIVATION   // الخطوة 4: تفعيل السجل الرقمي
}

/// حالة عملية التمليك
enum OwnershipProcessStatus {
  INITIATED              // تم بدء العملية
  PURCHASE_SUBMITTED     // طلب الشراء مقدم
  NOTARY_REVIEWING       // كاتب العدل يراجع
  NOTARY_CERTIFIED       // تم التوثيق
  KEY_ISSUED             // تم إصدار المفتاح للزبون
  KEY_ACTIVATED          // الزبون فعّل المفتاح
  COMPLETED              // العملية مكتملة
  DISPUTED               // متنازع عليها
  CANCELLED              // ملغاة
}

/// حالة المفتاح الرقمي
enum OwnershipKeyStatus {
  NOT_GENERATED          // لم يتم توليده بعد
  GENERATED              // تم التوليد (لدى كاتب العدل)
  ISSUED_TO_OWNER        // تم تسليمه للزبون
  ACTIVATED              // تم تفعيله من الزبون
  REVOKED                // تم إلغاؤه
}

/// حالة الم记录 الرقمي
enum DigitalRecordStatus {
  DRAFT                  // مسودة
  PENDING_ACTIVATION     // بانتظار التفعيل
  ACTIVATED              // مفعّل
  VERIFIED               // موثق على البلوكشين
  DISPUTED               // متنازع عليه
}

// ============================================================================
// نموذج عملية التمليك الأربعة
// ============================================================================

model OwnershipTransferProcess {
  id                String                @id @default(uuid()) @db.Uuid
  processId         String                @unique @db.VarChar(50) // OTP-XXXX-XXXX

  // الأصل المعني
  assetId           String                @db.Uuid
  asset             GoldAsset             @relation(fields: [assetId], references: [id])

  // الأطراف الأربعة
  customerId        String                @db.Uuid
  customer          User                  @relation("OwnershipCustomer", fields: [customerId], references: [id])
  notaryId          String?               @db.Uuid
  notary            NotaryAccount?        @relation(fields: [notaryId], references: [id])
  registrarId       String?               @db.Uuid
  registrar         DigitalRegistrar?     @relation(fields: [registrarId], references: [id])
  auditorId         String?               @db.Uuid

  // معلومات الصفقة
  salePrice         Decimal               @db.Decimal(14, 2)
  saleCurrency      Currency              @default(USD)
  saleDate          DateTime?             @db.Timestamptz
  contractHash      String?               @db.VarChar(255) // هاش عقد البيع

  // الحالة العامة
  currentStep       OwnershipStep         @default(PURCHASE_REQUEST)
  status            OwnershipProcessStatus @default(INITIATED)
  startedAt         DateTime              @default(now()) @db.Timestamptz
  completedAt       DateTime?             @db.Timestamptz

  // تتبع كل خطوة
  step1CompletedAt  DateTime?             @db.Timestamptz
  step2CompletedAt  DateTime?             @db.Timestamptz
  step3CompletedAt  DateTime?             @db.Timestamptz
  step4CompletedAt  DateTime?             @db.Timestamptz

  // السجل
  notes             String?               @db.VarChar(2000)
  disputeReason     String?               @db.VarChar(1000)

  createdAt         DateTime              @default(now()) @db.Timestamptz
  updatedAt         DateTime              @updatedAt @db.Timestamptz

  // العلاقات
  key               OwnershipKey?
  notaryRecord      NotaryRecord?
  registrarLog      DigitalRegistrarLog?
  auditWatchLogs    AuditorWatchLog[]
  escrow            EscrowLedger?

  @@index([customerId, status])
  @@index([assetId])
  @@index([status, currentStep])
  @@map("ownership_transfer_processes")
}

// ============================================================================
// حساب الزبون — Customer / Asset Owner
// ============================================================================

model OwnershipKey {
  id                String                @id @default(uuid()) @db.Uuid

  processId         String                @unique @db.Uuid
  process           OwnershipTransferProcess @relation(fields: [processId], references: [id])

  // المفتاح المشفر (يُخزَّن فقط الهاش — المفتاح الأصلي يبقى لدى الزبون)
  keyHash           String                @unique @db.VarChar(255) // SHA-256 of the actual key
  keyPrefix         String                @db.VarChar(12) // أول 12 حرف للتمييز
  keyAlgorithm      String                @default("AES-256-GCM") @db.VarChar(50)

  // بيانات المشفرة
  encryptedPayload  String                @db.Text // البيانات المشفرة بالمفتاح
  iv                String                @db.VarChar(64) // متجه البداية
  authTag           String                @db.VarChar(64) // علامة المصادقة

  // الحالة
  status            OwnershipKeyStatus    @default(NOT_GENERATED)
  generatedAt       DateTime?             @db.Timestamptz
  issuedAt          DateTime?             @db.Timestamptz
  activatedAt       DateTime?             @db.Timestamptz

  // معلومات الزبون
  ownerId           String                @db.Uuid
  owner             User                  @relation("OwnershipKeyOwner", fields: [ownerId], references: [id])

  createdAt         DateTime              @default(now()) @db.Timestamptz
  updatedAt         DateTime              @updatedAt @db.Timestamptz

  @@index([processId])
  @@index([ownerId])
  @@map("ownership_keys")
}

// ============================================================================
// حساب كاتب العدل — Notary / Trusted Legal Entity
// ============================================================================

model NotaryAccount {
  id                String                @id @default(uuid()) @db.Uuid
  notaryCode        String                @unique @db.VarChar(50) // NOT-XXXX

  // بيانات الكاتب
  userId            String                @unique @db.Uuid
  user              User                  @relation(fields: [userId], references: [id])

  // بيانات الترخيص
  licenseNumber     String                @db.VarChar(100) // رقم الترخيص
  licenseExpiry     DateTime              @db.Timestamptz
  officialSealHash  String                @db.VarChar(255) // هاش الختم الرسمي
  jurisdiction      String                @db.VarChar(100) // الولاية القضائية
  jurisdictionAr    String?               @db.VarChar(100)

  // المعممămă
  isActive          Boolean               @default(true)
  isSuspended       Boolean               @default(false)
  suspensionReason  String?               @db.VarChar(500)

  // إحصائيات
  totalCertifications Int                 @default(0)
  lastActivityAt    DateTime?             @db.Timestamptz

  createdAt         DateTime              @default(now()) @db.Timestamptz
  updatedAt         DateTime              @updatedAt @db.Timestamptz

  // العلاقات
  processes         OwnershipTransferProcess[]
  notaryRecords     NotaryRecord[]

  @@index([userId])
  @@index([licenseNumber])
  @@map("notary_accounts")
}

model NotaryRecord {
  id                String                @id @default(uuid()) @db.Uuid

  processId         String                @unique @db.Uuid
  process           OwnershipTransferProcess @relation(fields: [processId], references: [id])
  notaryId          String                @db.Uuid
  notary            NotaryAccount         @relation(fields: [notaryId], references: [id])

  // بيانات التوثيق
  contractDocumentHash String             @db.VarChar(255) // هاش وثيقة العقد
  saleAgreementHash    String             @db.VarChar(255) // هاش اتفاقية البيع
  witnessSignatures    Json               @default("[]") // توقيعات الشهود

  // إصدار المفتاح
  keyGeneratedForOwner Boolean           @default(false)
  keyHandoverMethod   String             @db.VarChar(50) // PHYSICAL, DIGITAL_SECURED
  keyHandoverTimestamp DateTime?          @db.Timestamptz

  // الاعتماد القانوني
  legalCertificationHash String           @db.VarChar(255)
  certifiedAt          DateTime           @default(now()) @db.Timestamptz
  certificationNotes   String?            @db.VarChar(1000)

  createdAt         DateTime              @default(now()) @db.Timestamptz
  updatedAt         DateTime              @updatedAt @db.Timestamptz

  @@index([processId])
  @@map("notary_records")
}

// ============================================================================
// حساب الكاتب الرقمي — Digital Registrar / Automated System
// ============================================================================

model DigitalRegistrar {
  id                String                @id @default(uuid()) @db.Uuid
  serviceCode       String                @unique @db.VarChar(50) // REG-SVC-001

  // حالة الخدمة
  verificationEngineStatus String         @default("OPERATIONAL") @db.VarChar(50)
  cryptographicProofVerifier String       @default("SHA256+ECDSA") @db.VarChar(100)
  lastHealthCheck   DateTime?             @db.Timestamptz

  // إعدادات الأمان
  maxVerificationsPerHour Int             @default(100)
  requireBlockchainAnchor  Boolean        @default(true)

  isActive          Boolean               @default(true)

  createdAt         DateTime              @default(now()) @db.Timestamptz
  updatedAt         DateTime              @updatedAt @db.Timestamptz

  // العلاقات
  processes         OwnershipTransferProcess[]
  registrarLogs     DigitalRegistrarLog[]

  @@map("digital_registrars")
}

model DigitalRegistrarLog {
  id                String                @id @default(uuid()) @db.Uuid

  processId         String                @unique @db.Uuid
  process           OwnershipTransferProcess @relation(fields: [processId], references: [id])
  registrarId       String                @db.Uuid
  registrar         DigitalRegistrar       @relation(fields: [registrarId], references: [id])

  // التحقق من المفتاح
  keyVerificationResult Boolean           @default(false)
  keyVerificationTimestamp DateTime?      @db.Timestamptz
  verificationEngineUsed  String          @db.VarChar(50)

  // مطابقة السجل
  recordMatchResult    Boolean            @default(false)
  contractMatchHash    String?            @db.VarChar(255)
  notaryCertMatchHash  String?            @db.VarChar(255)

  // تفعيل السجل الرقمي
  digitalRecordStatus  DigitalRecordStatus @default(DRAFT)
  blockchainTxHash     String?            @db.VarChar(255)
  blockchainBlockNumber BigInt?

  // النتيجة النهائية
  activationResult   String?              @db.VarChar(50) // SUCCESS, FAILED, PENDING
  activationTimestamp DateTime?            @db.Timestamptz
  failureReason      String?              @db.VarChar(500)

  createdAt         DateTime              @default(now()) @db.Timestamptz
  updatedAt         DateTime              @updatedAt @db.Timestamptz

  @@index([processId])
  @@map("digital_registrar_logs")
}

// ============================================================================
// حساب المشرف والمراقب الأمني — Security Compliance Auditor
// ============================================================================

model AuditorWatchLog {
  id                String                @id @default(uuid()) @db.Uuid

  processId         String                @db.Uuid
  process           OwnershipTransferProcess @relation(fields: [processId], references: [id])

  // بيانات المراقب
  auditorId         String                @db.Uuid
  auditLevel        String                @db.VarChar(50) // STANDARD, ENHANCED, CRITICAL

  // مراقبة فصل الصلاحيات
