// LAYER 09: CUSTODY & LOGISTICS — إدارة الخزائن والشحن
// ============================================================================

/// الخزائن الآمنة
model CustodyVault {
  id                String          @id @default(uuid()) @db.Uuid
  vaultCode         String          @unique @db.VarChar(50)
  name              String          @db.VarChar(200)
  
  warehouseId       String          @db.Uuid
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id])
  entityId          String?         @unique @db.Uuid
  entity            ExternalEntity? @relation(fields: [entityId], references: [id])
  
  // مواصفات الخزينة
  securityGrade     SecurityLevel   @default(HIGH_SECURITY)
  capacityKg        Decimal         @db.Decimal(10, 2) // السعة بالكيلوغرام
  currentOccupancyKg Decimal        @default(0) @db.Decimal(10, 2)
  temperatureControl Boolean        @default(true)
  humidityControl   Boolean         @default(true)
  fireSupression    Boolean         @default(true)
  cctvMonitoring    Boolean         @default(true)
  accessControl     AccessControlType @default(BIOMETRIC)
  
  // الحالة
  isActive          Boolean         @default(true)
  lastInspectionAt  DateTime?       @db.Timestamptz
  insuranceValue    Decimal?        @db.Decimal(14, 2)
  insuranceCurrency Currency        @default(USD)
  
  inventories       GoldErpInventory[]
