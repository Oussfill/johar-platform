  // مراقبة كل خطوة
  stepMonitored      OwnershipStep
  stepTimestamp       DateTime             @default(now()) @db.Timestamptz
  stepDataHash       String               @db.VarChar(255) // هاش بيانات الخطوة

  // التوصيات
  recommendation     String?              @db.VarChar(500)
  requiresEscalation Boolean              @default(false)

  createdAt         DateTime              @default(now()) @db.Timestamptz

  @@index([processId])
  @@index([auditorId])
  @@index([separationOfDutiesViolated])
  @@map("auditor_watch_logs")
}

// ============================================================================
// محرك الضمان المالي — Escrow Ledger
// ============================================================================
// ربط مالي كامل بمسار التمليك:
// Step 1: حجز المبلغ (HOLD)
// Step 2+3: المبلغ محجوز بآمان (HELD)
// Step 4: تحرير المبلغ للبائع (RELEASED)

enum EscrowStatus {
  PENDING           // بانتظار الإنشاء
  HOLD              // تم حجز المبلغ
  HELD              // المبلغ محجوز (أثناء التوثيق)
  RELEASED          // تم تحرير المبلغ للبائع
  REFUNDED          // تم استرداد المبلغ (إلغاء)
  DISPUTED          // متنازع عليه
  EXPIRED           // منتهي الصلاحية
}

enum EscrowEventType {
  CREATED           // إنشاء سجل الضمان
  HOLD_placed       // حجز المبلغ
  HOLD_confirmed    // تأكيد الحجز
  RELEASED          // تحرير المبلغ
  REFUNDED          // استرداد
  DISPUTE_raised    // فتح نزاع
  DISPUTE_resolved  // حل النزاع
  EXPIRED           // انتهاء الصلاحية
}

model EscrowLedger {
  id                String          @id @default(uuid()) @db.Uuid
  escrowCode        String          @unique @db.VarChar(50) // ESC-XXXX-XXXX

  // ربط بعملية التمليك
  processId         String          @unique @db.Uuid
  process           OwnershipTransferProcess @relation(fields: [processId], references: [id])

  // الأطراف المالية
  buyerId           String          @db.Uuid
  buyer             User            @relation("EscrowBuyer", fields: [buyerId], references: [id])
  sellerId          String          @db.Uuid
  seller            User            @relation("EscrowSeller", fields: [sellerId], references: [id])

  // المبالغ
  holdAmount        Decimal         @db.Decimal(14, 2)
  holdCurrency      Currency        @default(USD)
  platformFee       Decimal         @default(0) @db.Decimal(14, 2)
  releasedAmount    Decimal?        @db.Decimal(14, 2)

  // الحالة
  status            EscrowStatus    @default(PENDING)
  heldAt            DateTime?       @db.Timestamptz
  releasedAt        DateTime?       @db.Timestamptz
  expiresAt         DateTime        @db.Timestamptz

  // التوثيق
  holdTxRef          String?        @db.VarChar(100) // مرجع العملية البنكية
  releaseTxRef       String?        @db.VarChar(100)
  releaseAuthorization String?      @db.VarChar(255) // توقيع تحرير المبلغ

  createdAt         DateTime        @default(now()) @db.Timestamptz
  updatedAt         DateTime        @updatedAt @db.Timestamptz

  // العلاقات
  events            EscrowEvent[]

  @@index([processId])
  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, expiresAt])
  @@map("escrow_ledger")
}

model EscrowEvent {
  id                String          @id @default(uuid()) @db.Uuid

  escrowId          String          @db.Uuid
  escrow            EscrowLedger    @relation(fields: [escrowId], references: [id])

  eventType         EscrowEventType
  amount            Decimal         @db.Decimal(14, 2)
  currency          Currency        @default(USD)

  // �.���"�^�.���� ���"���.�"�S��
  performedBy       String          @db.Uuid
  notes             String?         @db.VarChar(500)
  txReference       String?         @db.VarChar(100)
  metadata          Json?           // ���S���ŝ��� �������?�S��

  createdAt         DateTime        @default(now()) @db.Timestamptz

  @@index([escrowId])
  @@index([eventType])
  @@map("escrow_events")
}

