  createdAt         DateTime        @default(now()) @db.Timestamptz
  updatedAt         DateTime        @updatedAt @db.Timestamptz

  @@index([warehouseId, isActive])
  @@map("custody_vaults")
}

enum AccessControlType {
  KEY
  COMBINATION
  BIOMETRIC
  DUAL_AUTH
  MULTI_FACTOR
}

/// سلسلة الحيازة — تتبع كل حركة للأصل بين الجهات
/// نظام الاعتماد الثنائي (Four-Eyes Principle) للأعمليات عالية القيمة
model ChainOfCustody {
  id                String          @id @default(uuid()) @db.Uuid
  custodyId         String          @unique @db.VarChar(50) // COC-XXXX-XXXX
  
  assetId           String          @db.Uuid
  asset             GoldAsset       @relation(fields: [assetId], references: [id])
  
  vaultId           String?         @db.Uuid
  vault             CustodyVault?   @relation(fields: [vaultId], references: [id])
  
  // نقل الحيازة
  fromEntityId      String          @db.Uuid
  fromEntity        ExternalEntity  @relation("FromEntity", fields: [fromEntityId], references: [id])
  toEntityId        String          @db.Uuid
  toEntity          ExternalEntity  @relation("ToEntity", fields: [toEntityId], references: [id])
  
  // نظام الاعتماد الثنائي (Four-Eyes Principle)
  transferType      TransferType    @default(INTERNAL)
  requiresDualAuth  Boolean         @default(false) // يتطلب اعتماداً ثنائياً
  dualAuthStatus    DualAuthStatus  @default(NOT_REQUIRED)
  
  // المُذِن والمُوَقِّع
  initiatedBy       String          @db.Uuid // المستخدم الذي بدأ العملية
  approvedBy        String?         @db.Uuid // المستخدم الذي وافق (ال的眼睛 الثانية)
  
  // تفاصيل النقل
  transportMethod   TransportMethod?
  trackingNumber    String?         @db.VarChar(100)
  insuranceValue    Decimal?        @db.Decimal(14, 2)
  estimatedArrival  DateTime?       @db.Timestamptz
  actualArrival     DateTime?       @db.Timestamptz
  
  // التوثيق
  handoverNotes     String?         @db.VarChar(2000)
  photoEvidenceUrl  String?         @db.VarChar(500)
  signatureHash     String?         @db.VarChar(255) // هاش التوقيع
  
  // الحالة
  status            CustodyEventStatus @default(PENDING)
  eventTimestamp    DateTime        @default(now()) @db.Timestamptz
  
  createdAt         DateTime        @default(now()) @db.Timestamptz
  updatedAt         DateTime        @updatedAt @db.Timestamptz

  @@index([assetId, eventTimestamp])
  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([dualAuthStatus])
  @@index([status])
  @@map("chain_of_custody")
}

enum TransferType {
  INTERNAL          // داخل نفس المؤسسة
  EXTERNAL          // إلى جهة خارجية
  RETURN            // إعادة
  DISPOSAL          // تخلص
  CUSTOMS_EXPORT    // تصدير جمركي
  CUSTOMS_IMPORT    // استيراد جمركي
}

enum DualAuthStatus {
  NOT_REQUIRED      // لا يتطلب اعتماداً ثنائياً
  PENDING_FIRST     // بانتظار الاعتماد الأول
  PENDING_SECOND    // بانتظار الاعتماد الثاني (ال的眼睛 الثانية)
  APPROVED          // تم الاعتماد من الطرفين
  REJECTED          // رفض أحد الطرفين
  EXPIRED           // انتهت صلاحية الطلب
}

enum TransportMethod {
  ARMORED_VEHICLE
  SECURED_PARCEL
  BANK_TRANSFER
  PERSONAL_CARRY
  DIPLOMATIC_POUCH
  AIR_FREIGHT
  SEA_FREIGHT
}

enum CustodyEventStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
  DISPUTED
}

/// طلبات نقل الأصول — تتطلب اعتماداً ثنائياً للأعمليات عالية القيمة
model CustodyTransferRequest {
  id                String          @id @default(uuid()) @db.Uuid
  requestId         String          @unique @db.VarChar(50) // CTR-XXXX-XXXX
  
  assetId           String          @db.Uuid
  asset             GoldAsset       @relation(fields: [assetId], references: [id])
  fromEntityId      String          @db.Uuid
  toEntityId        String          @db.Uuid
  
  initiatedById     String?         @db.Uuid
  initiatedBy       User?           @relation(fields: [initiatedById], references: [id])
  
  // معلومات الطلب
  reason            String          @db.VarChar(500)
  priority          Priority        @default(NORMAL)
  estimatedValue    Decimal         @db.Decimal(14, 2)
  valueCurrency     Currency        @default(USD)
  
  // يتحقق مما إذا كان يتطلب اعتماداً ثنائياً
  requiresDualAuth  Boolean         @default(false) // قيمة > حد معين
  
  // الاعتمادات
  firstApproverId   String?         @db.Uuid
  firstApprovalAt   DateTime?       @db.Timestamptz
  firstApprovalNote String?         @db.VarChar(500)
  
  secondApproverId  String?         @db.Uuid
  secondApprovalAt  DateTime?       @db.Timestamptz
  secondApprovalNote String?        @db.VarChar(500)
  
  // الحالة
  status            TransferRequestStatus @default(PENDING)
  rejectionReason   String?         @db.VarChar(500)
  
  // معلومات النقل (بعد الموافقة)
  custodyId         String?         @db.Uuid // الارتباط بسجل الحيازة
  
  createdAt         DateTime        @default(now()) @db.Timestamptz
  updatedAt         DateTime        @updatedAt @db.Timestamptz

