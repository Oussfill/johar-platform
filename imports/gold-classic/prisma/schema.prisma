/// سجل التدقيق العام — ي↠гуّ كل عملية في النظام
/// مطلوب لـ ISO 27001 و Zero-Trust Architecture
model AuditLog {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String?         @db.Uuid
  user              User?           @relation(fields: [userId], references: [id])
  
  action            String          @db.VarChar(100) // "ASSET_REGISTER", "ASSAY_COMPLETE", "TRANSFER_REQUEST"
  entityType        String          @db.VarChar(50) // الكيان المتأثر
  entityId          String?         @db.Uuid // معرّف الكيان
  
  // التفاصيل
  description       String?         @db.VarChar(1000)
  oldValues         Json?           // القيم قبل التغيير
